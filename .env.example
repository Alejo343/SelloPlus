# Conexión por socket Unix local: no hay contraseña que guardar.
DATABASE_URL=postgres:///fidelizacion_dev?host=/var/run/postgresql
DATABASE_URL_TEST=postgres:///fidelizacion_test?host=/var/run/postgresql

# Versión del texto de consentimiento que se guarda con cada cliente (RL-02).
CONSENTIMIENTO_VERSION=2026-11-v1

# Firma la cookie que identifica al cliente entre visitas. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_SESION=cambiame-por-un-secreto-aleatorio-de-64-hex

# URL pública del servicio, para que los QR impresos apunten a algo alcanzable.
URL_PUBLICA=https://tu-dominio.com
